{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-nexus.pocketui.gallery",
  "title": "PocketUI Gallery",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": ["text.glyphs.baked", "input.buttons"],
      "enhances": ["display.auxiliary", "input.touch.auxiliary"]
    }
  },
  "app": {
    "entry": "gallery/main.tsx",
    "output": "pocketui-gallery",
    "framework": "solid",
    "modality": { "touch": "auxiliary" },
    "surfaces": { "auxiliary": { "adaptive": { "min": [320, 240], "max": [640, 720] } } },
    "viewport": { "fixed": { "logical": [[400, 240], [512, 384]], "presentation": "native" } }
  }
}
